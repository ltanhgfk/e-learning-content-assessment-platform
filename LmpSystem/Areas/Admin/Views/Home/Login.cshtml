@model LmpSystem.ViewModels.UserLoginViewModel


@{ ViewBag.Title = "ADMIN PANEL";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";
}

<div class="container" style="background-image: url(~/Content/images/thuenhanuoclogo.png); width: 100%; text-align: center; margin-top: 0px;">
    <div class="row">
        <div class="col-sm-9 col-md-7 col-lg-5 mx-auto" style="margin-top: 13px;">
            <div class="card card-signin my-5">
                <div class="card-body">

                    <h4 class="card-title text-center">ĐĂNG NHẬP</h4>
                    <div class="text-center text-danger">@ViewBag.Error</div>
                    <form class="form-signin" method="post">

                        <div class="form-label-group">
                            <label for="Username">User name</label><br />
                            @Html.TextBoxFor(m => m.Username, new { @class = "form-control", @placeholder = "UserName" })
                            @Html.ValidationMessageFor(model => model.Username, "", new { @class = "text-danger" })

                        </div>

                        <div class="form-label-group">

                            <label for="Password">Password</label><br />
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", @placeholder = "Password" })
                            @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })

                        </div>

                        <div class="form-group">
                            @*<input type="checkbox" class="custom-control-input" id="customCheck1">*@
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "" })
                            Remember me
                        </div>
                        <button class="btn btn-lg btn-warning btn-block text-uppercase" type="submit">Đăng nhập</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
