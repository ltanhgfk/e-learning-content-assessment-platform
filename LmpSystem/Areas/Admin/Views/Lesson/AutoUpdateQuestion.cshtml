                <div class="col-md-10">
                    <select id="SubCateId" name="SubCateId" class="form-control" , required="required"></select>
                    @Html.ValidationMessage("SubCateId", "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.Label("Thuộc khóa học (bài viết)", htmlAttributes: new { @class = "control-label col-md-4" })
