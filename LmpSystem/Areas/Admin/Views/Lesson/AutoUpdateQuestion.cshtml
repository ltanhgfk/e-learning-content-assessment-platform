    - Định dạng có phần giải thích đáp án, các phương án có thứ tự a, b, c, d.
    </pre>
</p>
@using (Html.BeginForm("AutoUpdateQuestion", "Lesson", FormMethod.Post, new { enctype = "multipart/form-data" }))
