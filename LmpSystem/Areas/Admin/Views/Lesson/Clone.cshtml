@model LmpSystem.ViewModels.LessonEditViewModel

@{
    ViewBag.Title = "Thêm bài mới";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";
}

<style>
    #imganno, #avatarPost {
        display: none;
    }
</style>

<h2>ĐĂNG BÀI HỌC MỚI</h2>

@using (Html.BeginForm("Clone", "Lesson", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div>
        <div class="form-horizontal">

            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Id)
            @Html.HiddenFor(model => model.PostId)
            @Html.HiddenFor(model => model.Avatar)
            <hr />

            <div class="form-group">
                @Html.Label("Thẻ tag bài viết:", htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    <div class="row" style="margin-left: 0px;">
                        @for (int i = 0; i < Model.TagList.Count; i++)
                        {
                            string title = Model.TagList[i].Text;
                            <div class="col-md-4 form-check abc-checkbox abc-checkbox-primary">
                                @Html.HiddenFor(model => model.TagList[i].Value)
                                @Html.CheckBoxFor(model => model.TagList[i].Selected, new { @class = "form-check-input" })
                                @Html.LabelFor(model => model.TagList[i].Selected, title, new { @class = "form-check-label" })
                            </div>}
                    </div>
                    @Html.ValidationMessageFor(model => model.TagList, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Name, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control", required = "required" } })
                    @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                </div>
            </div>            

            <!--khuc upload anh-->
            <div class="form-group">
                @Html.Label("Thay đổi ảnh đại diện:", htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    <label class="switch">
                        <input type="checkbox" id="changeAvatar" name="changeAvatar" value="@(ViewBag.ChangeAvatar == true ? "true" : "false")" class="success">
                        <span class="slider"></span>
                    </label>
                    <p id="changeAvtText" style="display:inline"> Giữ nguyên</p>
                </div>
            </div>
            <div class="form-group" id="avatarPost">
                @Html.Label("Ảnh đại diện: ", htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    <input type="file" id="AvatarFile" name="AvatarFile" class="form-control-file" />
                    @Html.ValidationMessageFor(model => model.AvatarFile, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                <div class="col-md-10" style="text-align:center">
                    <img class="img-responsive" style="max-width:60%;text-align:center" id="avtpreview" src="~/Upload/images/@Model.Avatar" alt="Ảnh đại diện" />
                </div>
            </div>

            <!--Het khuc upload anh-->
            <div class="form-group">
                @Html.LabelFor(model => model.Position, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Position, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Position, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Video, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.Video, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Video, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Resume, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.Resume, new { rows = "5", cols = "138" })
                    @Html.ValidationMessageFor(model => model.Resume, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.Content, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.TextAreaFor(model => model.Content, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Content, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
            @Html.LabelFor(model => model.Exercises, htmlAttributes: new { @class = "control-label col-md-4" })
            <div class="col-md-10">
                @Html.TextAreaFor(model => model.Exercises, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Exercises, "", new { @class = "text-danger" })
            </div>
        </div>

            <script>
                var editor1 = CKEDITOR.replace('Video', { width: '100%', height: '100' });
                /*var editor2 = CKEDITOR.replace('Resume', { width: '100%', height: '100' });*/
                var editor3 = CKEDITOR.replace('Content', { width: '100%', height: '600' });
                var editor4 = CKEDITOR.replace('Exercises', { width: '100%', height: '600' });
            </script>

            <div class="form-group">
                @Html.Label("Trạng thái bài viết:", htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    <label class="switch">
                        <input type="checkbox" id="Status" name="Status" value="@(Model.Status == true ? "true" : "false")" @(Model.Status == true ? "checked" : "") class="success">
                        <span class="slider"></span>
                    </label>

                    <p id="showstatus" style="display:inline"> Đăng ngay</p>
                </div>
            </div>          

            <div class="form-group">
                <div style="float:left; margin-right: 20px;">
                    <input type="submit" value="Lưu" class="btn btn-warning" />
                </div>
                <div style="float:left">
                    @Html.ActionLink("Quay lại", "Index", new { id = Model.Id }, new { @class = "btn btn-primary" })
                </div>
            </div>

        </div>
    </div>
}

<script>   

    $('#Status').change(function () {
        var x = $('#Status').prop("checked");
        if (x == true) {
            $('#showstatus').text(' Đăng ngay');
            $('#Status').val('true');
        }
        else if (x == false) {
            $('#showstatus').text(' Đăng nháp (không hiển thị)');
            $('#Status').val('false');
        }
    });

    $('#changeAvatar').change(function () {
        var x = $('#changeAvatar').prop("checked");
        if (x == true) {
            $('#changeAvtText').text(' Giữ nguyên');
            $('#changeAvatar').val('true');
            $('#avatarPost').show();
            $('#avtpreview').show();
        }
        else if (x == false) {
            $('#changeAvtText').text(' Thay đổi');
            $('#changeAvatar').val('false');
            $('#avatarPost').hide();
            //$('#avtpreview').hide();
            $("#AvatarFile").val(null);
        }
    });

    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#avtpreview').attr('src', e.target.result);
            }

            reader.readAsDataURL(input.files[0]);
        }
    }

    $("#AvatarFile").change(function () {
        readURL(this);
    });    

</script>