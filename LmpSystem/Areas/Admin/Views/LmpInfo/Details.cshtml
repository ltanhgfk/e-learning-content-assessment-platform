@model LmpSystem.ViewModels.LmpInfoViewModel

@{
    ViewBag.Title = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";
}

<h2>CHI TIẾT NGƯỜI DÙNG</h2>
<div class="container">
    <table class="table table-hover">
        @*<thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Nội dung</th>
                </tr>
            </thead>*@
        <tbody>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Avatar)
                </td>

                <td>
                    <img src="~/Upload/images/@Model.Avatar" style="width: 200px;" />
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Code)
                </td>

                <td>
                    @Html.DisplayFor(model => model.Code)
                </td>
            </tr>

            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Name)
                </td>

                <td>
                    @Html.DisplayFor(model => model.Name)
                </td>
            </tr>

            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Link)
                </td>

                <td>
                    @Html.DisplayFor(model => model.Link)
                </td>
            </tr>

            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Content)
                </td>

                <td>
                    @Html.DisplayFor(model => model.Content)
                    @Html.Raw(Model.Content)
                </td>
            </tr>

            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.Status)
                </td>

                <td>
                    @Html.DisplayFor(model => model.Status)
                    @(Model.Status==true? "Đã được hiển thị":"Chưa được hiển thị")
                </td>
            </tr>

            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.CreatedByUser)
                </td>

                <td>
                    @Html.DisplayFor(model => model.CreatedByUser)
                </td>
            </tr>
            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.CreatedOnDate)
                </td>

                <td>
                    @Html.DisplayFor(model => model.CreatedOnDate)
                </td>
            </tr>

            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.LastModifiedByUser)
                </td>

                <td>
                    @Html.DisplayFor(model => model.LastModifiedByUser)
                </td>
            </tr>

            <tr>
                <td>
                    @Html.DisplayNameFor(model => model.LastModifiedOnDate)
                </td>

                <td>
                    @Html.DisplayFor(model => model.LastModifiedOnDate)
                </td>
            </tr>

        </tbody>
    </table>

</div>

<div class="form-group">
    <div style="float:left; margin-right: 20px;">
        @Html.ActionLink("Cập nhật", "Edit", new { id = Model.Id }, new { @class = "btn btn-primary" })
    </div>
    <div style="float:left">
        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-primary" })
    </div>
</div>
