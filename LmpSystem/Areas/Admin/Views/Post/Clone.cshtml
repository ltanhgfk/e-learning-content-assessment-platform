    $("#SuperCateId").change(function () {
        getSubCate();
    });

    var getSubCate = function () {
        //alert("Vô getSubCate, cateid = " + $("#SuperCateId").val())
        $.ajax({
            type: "POST",
            url: '/Post/GetSubCate',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: $("#SuperCateId").val() }),
            dataType: "json",
            success: function (recData) {
                $("#CateId").empty();
                $.each(recData, function (index, optiondata) {
                    $("#CateId").append("<option value='" + optiondata.Value + "'>" + optiondata.Text + "</option>");
                });
            },
            error: function () { alert('Có lỗi (ajax) xảy ra!'); }
