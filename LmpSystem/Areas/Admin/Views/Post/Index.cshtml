@model IEnumerable<LmpSystem.ViewModels.PostDetailViewModel>

@*@model PagedList.IPagedList<LmpSystem.ViewModels.PostDetailViewModel>*@
@*@using PagedList.Mvc;*@

@{
    ViewBag.Title = "Quản trị bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";
    LmpSystem.Common.GetData data = new LmpSystem.Common.GetData();
}

<link href="~/Content/AdminLTE/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<div style="margin-top:10px;">

    <div class="row">
        <div class="col-12">
            <h2 class="text-center text-uppercase">Quản Lý Bài viết</h2>
        </div>
    </div>

    @ViewBag.error

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-lg-10 col-sm-12 col-md-10">
                            @using (Html.BeginForm("Index", "Post", FormMethod.Get, new { enctype = "multipart/form-data", @class = "form-inline" }))
                            {
                                <label style="display:inline-block;font-weight:normal;margin-top: 10px;">
                                    @Html.DropDownList("post_type", (SelectList)data.GetListPostType(), htmlAttributes: new { @class = "form-control" })
                                    @*<input name="titleStr" type="search" value="@(ViewBag.titleStr as string)" class="form-control" placeholder="Tiêu đề">*@
                                    <input style="margin-left:0px" class="btn btn-info" type="submit" value="Tìm kiếm" />
                                </label>}
                        </div>

                        <div class="col-lg-1 col-sm-12 col-md-1">
                            <div class="card-tools">
                                <div class="input-group input-group-sm" style="margin-top: 10px; text-align: right">
                                    @Html.ActionLink("+Thêm Bài viết", "Create", null, new { @class = "btn btn-warning" })
                                    @*<button id="addTag" class="btn btn-primary"><i class="fa fa-plus"></i> Thêm bài viết</button>*@

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- /.card-header -->
                <div class="card-body">
                    <table id="lstPost" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().Avatar)
                                </th>
                                @*<th>
                                        @Html.DisplayNameFor(model => model.Single().Code)
                                    </th>*@
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().Name)
                                </th>
                                @*<th>
                                        @Html.DisplayNameFor(model => model.Single().Position)
                                    </th>*@
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().CateName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().PostType)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().Status)
                                </th>
                                @*<th>
                                        @Html.DisplayNameFor(model => model.Single().Price)
                                    </th>*@
                                @*<th>
                                        @Html.DisplayNameFor(model => model.Single().Discount)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Single().Quantity)
                                    </th>
                                    <th>
                                        @Html.DisplayNameFor(model => model.Single().Username)
                                    </th>*@
                                <th>
                                    @*@Html.DisplayNameFor(model => model.Single().BeginDate)*@
                                    @Html.DisplayNameFor(model => model.Single().Position)
                                </th>
                                <th>
                                    Số lượng bài học
                                </th>
                                <th>
                                    Số lượng câu hỏi trắc nghiệm
                                </th>
                                <th>Quản trị</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="~/Upload/images/@item.Avatar" style="width:70px; height:70px" />@*@Html.DisplayFor(modelItem => item.Avatar)*@
                                    </td>
                                    @*<td>
                                            @Html.DisplayFor(modelItem => item.Code)
                                        </td>*@
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Name)
                                    </td>
                                    @*<td>
                                            @Html.DisplayFor(modelItem => item.Position)
                                        </td>*@
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CateName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PostType)
                                    </td>
                                    <td>
                                        @*@Html.DisplayFor(modelItem => item.Status)*@
                                        <label class="switch">
                                            <input onchange="changeStatus(this)" type="checkbox" id="@item.Id" @(item.Status == true ? "checked" : "")>
                                            <span class="slider"></span>
                                        </label>
                                    </td>
                                    @*<td>
                                            @Html.DisplayFor(modelItem => item.Price)
                                        </td>*@
                                    @*<td>
                                            @Html.DisplayFor(modelItem => item.Discount)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Quantity)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Username)
                                        </td>*@
                                    <td>
                                        @*@Html.DisplayFor(modelItem => item.BeginDate)*@
                                        @Html.DisplayFor(modelItem => item.Position)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Lessons.Count)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Questions.Count)
                                    </td>
                                    <td>
                                        @*@{ if (User.Identity.Name == item.Username || User.IsInRole("admin"))
        {*@
                                        @Html.ActionLink("Cập nhật", "Edit", new { id = item.Id }, new { @class = "badge badge-warning" })
                                        @Html.ActionLink("Chi tiết", "Details", new { id = item.Id }, new { @class = "badge badge-success" })
                                        <a onclick="deleteConfirm(@item.Id, '@item.Name')" href="#" class="badge badge-danger">Xóa</a>
                                        @Html.ActionLink("Tạo bản sao", "Clone", new { id = item.Id }, new { @class = "badge badge-primary" })
                                        @*@Html.ActionLink("Images", "ImageIndex", new { PostId = item.Id }, new { @class = "badge badge-info" })
        @Html.ActionLink("Lessons", "PostLesson", new { PostId = item.Id }, new { @class = "badge badge-secondary" })*@
                                        @Html.ActionLink("Chuyển thành bài viết thành bài học","TransferToLesson","Lesson", new { postid = item.Id }, new { @class = "badge badge-warning" })
                                        @Html.ActionLink("Thêm hình ảnh", "Index", "PostImage", new { id = item.Id }, new { @class = "badge badge-info" })
                                        @Html.ActionLink("Cập nhật bài học", "Index", "Lesson", new { id = item.Id }, new { @class = "badge badge-info" })

                                        @Html.ActionLink("Tải bộ câu hỏi có phần giải thích", "AutoUpdateQuestion", new { id = item.Id }, new { @class = "badge badge-warning" })
                                        @Html.ActionLink("Tải bộ câu hỏi không có phần giải thích", "AutoUpdateQuestionNoExp", new { id = item.Id }, new { @class = "badge badge-warning" })
                                        @Html.ActionLink("Tải bộ câu hỏi không có phần giải thích và không có ABC", "AutoUpdateQuestionNoExpNoABC", new { id = item.Id }, new { @class = "badge badge-warning" })
                                        @Html.ActionLink("Cập nhật thủ công câu hỏi", "Index", "Question", new { postid = item.Id }, new { @class = "badge badge-info" })
                                        <a onclick="deleteQuestionConfirm(@item.Id, '@item.Name')" href="#" class="badge badge-danger">Xóa toàn bộ câu hỏi</a>

                                        @*}
        }*@
                                    </td>
                                </tr>

                            }
                        </tbody>

                    </table>
                </div>
                <!-- /.card-body -->

            </div>
            <!-- /.card -->
        </div>
        <!-- /.col -->
    </div>

</div>

<!-- The delete Modal -->
<div class="modal fade" id="deleteModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Bạn có chắc muốn xóa bài viết này?</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" id="deleteBtn" class="btn btn-danger">Xóa</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>

        </div>
    </div>
</div>

<!-- The delete Modal -->
<div class="modal fade" id="deleteModalQuestion">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Bạn có chắc muốn xóa toàn bộ câu hỏi trắc nghiệm thuộc bài viết này?</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" id="deleteQuestionBtn" class="btn btn-danger">Xóa</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>

        </div>
    </div>
</div>

<script src="~/Content/AdminLTE/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/Content/AdminLTE/plugins/datatables/dataTables.bootstrap4.min.js"></script>

<script>
    //--Kiem tra file co phai la ảnh không
    //const file = this.files[0];
    //const  fileType = file['type'];
    //const validImageTypes = ['image/gif', 'image/jpeg', 'image/png'];
    //if (!validImageTypes.includes(fileType)) {
    //    // invalid file type code goes here.
    //    alert("Tập tin ảnh không đúng định dạng!");
    //}
    //--bằng jquery--
    //var file = this.files[0];
    //var fileType = file["type"];
    //var validImageTypes = ["image/gif", "image/jpeg", "image/png"];
    //if ($.inArray(fileType, validImageTypes) < 0) {
    //     // invalid file type code goes here.
    //    alert("Tập tin ảnh không đúng định dạng!");
    //}
    //---------------------------------------------------------------

    $(function () {
        $("#lstPost").DataTable();
    });

    var delmodal = $('#deleteModal');
    var idx;
    var deleteConfirm = function (id, title) {
        idx = id;
        delmodal.find('.modal-body').text(title);
        delmodal.modal('show');
    }
    $('#deleteBtn').click(function () {
        delmodal.modal('hide');
        $.ajax({
            type: "POST",
            url: '/Post/Delete',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: idx }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify(recData.Message, {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 1000,
                });
                setTimeout(function () {
                    window.location.reload();
                }, 2000);

            },
            error: function () {
                var notify = $.notify('Có lỗi (ajax) xảy ra, chưa xóa được!', {
                    type: 'pastel-warning',
                    allow_dismiss: false,
                });
            }
        });
    });

    //------------------------------

    var delmodalquestion = $('#deleteModalQuestion');
    var idxq;
    var deleteQuestionConfirm = function (idq, titleq) {
        idxq = idq;
        delmodalquestion.find('.modal-body').text(titleq);
        delmodalquestion.modal('show');
    }
        $('#deleteQuestionBtn').click(function () {
            delmodalquestion.modal('hide');
            $.ajax({
                type: "POST",
                url: '/Post/DeleteQuestion',
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ id: idxq }),
                dataType: "json",
                success: function (recData) {
                    var notify = $.notify(recData.Message, {
                        type: 'pastel-info',
                        allow_dismiss: false,
                        timer: 1000,
                    });
                    setTimeout(function () {
                        window.location.reload();
                    }, 2000);

                },
                error: function () {
                    var notify = $.notify('Có lỗi (ajax) xảy ra, chưa xóa được!', {
                        type: 'pastel-warning',
                        allow_dismiss: false,
                    });
                }
            });
        });

    var changeStatus = function (xthis) {
        alert("Status: " + xthis.checked);
        var xid = xthis.id;
        var st = xthis.checked;
        $.ajax({
            type: "POST",
            url: '/Post/ChangeStatus',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: xid, state: st }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify(recData.Message, {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 1000,
                });
            },
            error: function () { alert('Có lỗi (ajax) xảy ra!'); }
        });
    }

</script>
