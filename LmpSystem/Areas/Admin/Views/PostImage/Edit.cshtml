        //var xid = xthis.id;
        //var st = xthis.checked;
        $.ajax({
            type: "POST",
            url: '/Post/GetCateByPostType',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: $("#PostType").val() }),
            dataType: "json",
            success: function (recData) {
                //var notify = $.notify('<strong>Thành công</strong><br/>' + recData.Message + '<br />', {
                //    type: 'pastel-info',
                //    allow_dismiss: false,
                //    timer: 1000,
                //});
                alert("ok con de: ");
                $("#SuperCateId").empty();
                $("#SuperCateId").append("<option value='0'>Choose sub category</option>");
                $.each(recData, function (index, optiondata) {
                    $("#SuperCateId").append("<option value='" + optiondata.Value + "'>" + optiondata.Text + "</option>");
                });
            },
            error: function () { alert('An error occured'); }
        });
    }

    $("#SuperCateId").change(function () {
        //getCateByPostType();
