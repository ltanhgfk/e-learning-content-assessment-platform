@model LmpSystem.ViewModels.PostReviewEditViewModel

@{
    ViewBag.Title = "Cập nhật bình luận";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";
}

<h2>CẬP NHẬT BÌNH LUẬN</h2>

@using (Html.BeginForm("Edit", "PostReview", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div>
        <div class="form-horizontal">

            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model=>model.Id)

            <div class="form-group">
                @Html.LabelFor(model => model.UserId, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @*@Html.EditorFor(model => model.UserId, new { htmlAttributes = new { @class = "form-control" } })*@
                    @Html.DropDownListFor(model => model.UserId, new SelectList(Model.Users, "Value", "Text"), new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.UserId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.PostId, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @*@Html.EditorFor(model => model.UserId, new { htmlAttributes = new { @class = "form-control" } })*@
                    @Html.DropDownListFor(model => model.PostId, new SelectList(Model.Posts, "Value", "Text"), new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.PostId, "", new { @class = "text-danger" })
                </div>
            </div>

            @*<div class="form-group">
                @Html.LabelFor(model => model.Time, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Time, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Time, "", new { @class = "text-danger" })
                </div>
            </div>*@

            <div class="form-group">
                @Html.LabelFor(model => model.Comment, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Comment, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Comment, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Rating, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.Rating, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Rating, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.LabelFor(model => model.LikeIt, htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.LikeIt, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.LikeIt, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                @Html.Label("Trạng thái:", htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    <label class="switch">
                        <input type="checkbox" id="Status" name="Status" value="@(Model.Status == true ? "true" : "false")" @(Model.Status == true ? "checked" : "") class="success">
                        <span class="slider"></span>
                    </label>

                    <p id="showstatus" style="display:inline"> Đăng ngay</p>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <input type="submit" value="Lưu" class="btn btn-warning" />
                    @Html.ActionLink("Trở lại danh sách", "Index", null, new { @class = "btn btn-warning" })
                </div>
            </div>

        </div>
    </div>
}

<script>   

    $('#Status').change(function () {
        var x = $('#Status').prop("checked");
        if (x == true) {
            $('#showstatus').text(' Đăng ngay');
            $('#Status').val('true');
        }
        else if (x == false) {
            $('#showstatus').text(' Đăng nháp (không hiển thị)');
            $('#Status').val('false');
        }
    });

</script>