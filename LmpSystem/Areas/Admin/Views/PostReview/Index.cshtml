@model IEnumerable<LmpSystem.ViewModels.PostReviewDetailViewModel>

@{
    ViewBag.Title = "Quản lý bình luận - đánh giá";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";
    LmpSystem.Common.GetData data = new LmpSystem.Common.GetData();
}


<link href="~/Content/AdminLTE/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<div style="margin-top:10px;">

    <div class="row">
        <div class="col-12">
            <h2 class="text-center text-uppercase">Quản lý đánh giá - bình luận</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        @*<div class="col-lg-10 col-sm-12 col-md-10">
                                @using (Html.BeginForm("Index", "PostReview", FormMethod.Get, new { enctype = "multipart/form-data", @class = "form-inline" }))
                                {
                                    <label style="display:inline-block;font-weight:normal;margin-top: 10px;">
                                        @Html.DropDownList("PostReview_type", (SelectList)data.GetListPostReviewType(), htmlAttributes: new { @class = "form-control" })
                                        <input style="margin-left:0px" class="btn btn-info" type="submit" value="Tìm kiếm" />
                                    </label>}
                            </div>*@

                        <div class="col-lg-1 col-sm-12 col-md-1">
                            <div class="card-tools">
                                <div class="input-group input-group-sm" style="margin-top: 10px; text-align: right">
                                    @Html.ActionLink("+Thêm đánh giá", "Create", null, new { @class = "btn btn-warning" })
                                    @*<button id="addTag" class="btn btn-primary"> new { id = ViewBag.PostId },  <i class="fa fa-plus"></i> Thêm bài viết</button>*@

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- /.card-header -->
                <div class="card-body">
                    <table id="lstPost" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.Time)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.PostName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Rating)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Comment)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.LikeIt)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Username)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Status)
                                </th>

                                <th>Quản trị</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Time)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.PostName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Rating)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Comment)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.LikeIt)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Username)
                                    </td>
                                    <td>
                                        @*@Html.DisplayFor(modelItem => item.Status)*@
                                        <label class="switch">
                                            <input onchange="changeStatus(this)" type="checkbox" id="@item.Id" @(item.Status == true ? "checked" : "")>
                                            <span class="slider"></span>
                                        </label>
                                    </td>

                                    <td>
                                        @*@{ if (User.Identity.Name == item.Username || User.IsInRole("admin"))
                                            {*@
                                        @Html.ActionLink("Sửa", "Edit", new { id = item.Id }, new { @class = "badge badge-warning" })
                                        @*@Html.ActionLink("Chi tiết", "Details", new { id = item.Id }, new { @class = "badge badge-success" })*@
                                        <a onclick="deleteConfirm(@item.Id, '@item.Comment')" href="#" class="badge badge-danger">Xóa</a>
                                        @Html.ActionLink("Bản sao", "Clone", new { id = item.Id }, new { @class = "badge badge-primary" })

                                        @*}
                                            }*@
                                    </td>
                                </tr>

                            }
                        </tbody>
                        
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- The delete Modal -->
<div class="modal fade" id="deleteModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Bạn có muốn xóa bài viết ?</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" id="deleteBtn" class="btn btn-danger">Xóa</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>
<script src="~/Content/AdminLTE/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/Content/AdminLTE/plugins/datatables/dataTables.bootstrap4.min.js"></script>


<script>
    $(function () {
        $("#lstPost").DataTable();
    });

    var delmodal = $('#deleteModal');
    var idx;
    var deleteConfirm = function (id, title) {
        idx = id;
        delmodal.find('.modal-body').text(title);
        delmodal.modal('show');

    }
    $('#deleteBtn').click(function () {
        delmodal.modal('hide');
        $.ajax({
            type: "Post",
            url: '/PostReview/Delete',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: idx }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify(recData.Message, {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 1000,
                });
                setTimeout(function () {
                    window.location.reload();
                }, 2000);

            },
            error: function () {
                var notify = $.notify('<strong>Lỗi (Ajax)</strong><br/>Không xóa được<br />', {
                    type: 'pastel-warning',
                    allow_dismiss: false,
                });
            }
        });
    });

    var changeStatus = function (xthis) {
        //alert("Status: " + xthis.checked);
        var xid = xthis.id;
        var st = xthis.checked;
        $.ajax({
            type: "Post",
            url: '/PostReview/ChangeStatus',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: xid, state: st }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify(recData.Message, {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 1000,
                });
            },
            error: function () { alert('Xảy ra lỗi (Ajax), chưa thay đổi được!'); }
        });
    }

</script>
