    $("#SuperCateId").change(function () {
            getSubCate();
    });

    var getSubCate = function () {
        //alert("Vô getSubCate, cateid = " + $("#SuperCateId").val())
        $.ajax({
            type: "POST",
            url: '/Question/GetSubCate',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: $("#SuperCateId").val() }),
            dataType: "json",
            success: function (recData) {
                $("#SubCateId").empty();
                $.each(recData, function (index, optiondata) {
                    $("#SubCateId").append("<option value='" + optiondata.Value + "'>" + optiondata.Text + "</option>");
                });
            },
            error: function () { alert('Có lỗi (ajax) xảy ra!'); }
        });
    }

    $("#SubCateId").change(function () {
        getPostList();
    });

    var getPostList = function () {
        //alert("Vô getSubCate, cateid = " + $("#SuperCateId").val())
        $.ajax({
            type: "POST",
            url: '/Question/GetPostList',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: $("#SubCateId").val() }),
            dataType: "json",
            success: function (recData) {
                $("#CourseId").empty();
                $.each(recData, function (index, optiondata) {
                    $("#CourseId").append("<option value='" + optiondata.Value + "'>" + optiondata.Text + "</option>");
                });
            },
            error: function () { alert('Có lỗi (ajax) xảy ra!'); }
        });
    }


</script>