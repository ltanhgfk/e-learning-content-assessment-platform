@model LmpSystem.ViewModels.QuestionViewModel

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";
}

<h2>CẬP NHẬT CÂU HỎI TỰ ĐỘNG</h2>

@using (Html.BeginForm("CreateAuto", "Question", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div>
        <div class="form-horizontal">

            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @*@Html.HiddenFor(model => model.CateId)*@

            <div class="form-group">
                @ViewBag.error
            </div>
                <div class="form-group">
                    @Html.Label("Tập tin câu hỏi (file txt):", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-10">
                        <input type="file" id="UploadedQuestionFile" name="UploadedQuestionFile" class="form-control-file" required="required" accept=".txt" />
                        @Html.ValidationMessage("UploadedQuestionFile", "", new { @class = "text-danger" })
                    </div>
                </div>

                @*<div class="form-group">
                @Html.Label("PostType", htmlAttributes: new { @class = "control-label col-md-4" })
                <div class="col-md-10">
                    @Html.EnumDropDownList("PostType", new { @class = "form-control" })
                    @Html.ValidationMessage("PostType", "", new { @class = "text-danger" })
                </div>
            </div>*@

                <div class="form-group">
                    @Html.Label("Thể loại bài viết", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-10">
                        @*@Html.EditorFor(model => model.UserId, new { htmlAttributes = new { @class = "form-control" } })*@
                        @Html.DropDownList("PostType", new SelectList(ViewBag.PostType, "Value", "Text"), new { @class = "form-control" })
                        @Html.ValidationMessage("PostType", "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Danh mục gốc bài viết", htmlAttributes: new { @class = "control -label col-md-4" })
                    <div class="col-md-10">
                        <select id="SuperCateId" name="SuperCateId" class="form-control" , required="required"></select>
                        @Html.ValidationMessage("SuperCateId", "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Danh mục bài viết", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-10">
                        <select id="SubCateId" name="SubCateId" class="form-control" , required="required"></select>
                        @Html.ValidationMessage("SubCateId", "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("CourseId", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-10">
                        <select id="CourseId" name="CourseId" class="form-control" , required="required"></select>
                        @Html.ValidationMessage("CourseId", "", new { @class = "text-danger", required = "required" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("CateId", htmlAttributes: new { @class = "control-label col-md-4" })
                    <div class="col-md-10">
                        @Html.DropDownList("CateId", new SelectList((IEnumerable<SelectListItem>)ViewBag.ParentCateList, "Value", "Text"), htmlAttributes: new { @class = "form-control" })
                        @Html.ValidationMessage("CateId", "", new { @class = "text-danger", required = "required" })
                    </div>
                </div>

                <div class="form-group">
                    <div style="float:left; margin-right: 20px;">
                        <input type="submit" value="Lưu" class="btn btn-warning" />
                    </div>
                    <div style="float:left">
                        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-primary" })
                    </div>
                </div>

            </div>
        </div>
}

<script>

    var firstcateid = 0;

    $('#Status').change(function () {
        var x = $('#Status').prop("checked");
        if (x == true) {
            $('#showstatus').text(' Đăng ngay');
            $('#Status').val('true');
        }
        else if (x == false) {
            $('#showstatus').text(' Đăng nháp (không hiển thị)');
            $('#Status').val('false');
        }
    });       

