        $('#Status').change(function () {
        var x = $('#Status').prop("checked");
        if (x == true) {
            $('#showstatus').text(' Đăng ngay');
        $('#Status').val('true');
        }
        else if (x == false) {
            $('#showstatus').text(' Đăng nháp (không hiển thị)');
        $('#Status').val('false');
        }
    });

        function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

        reader.onload = function (e) {
            $('#avtpreview').attr('src', e.target.result);
            }
        reader.readAsDataURL(input.files[0]);
        }
    }

        $("#AvatarFile").change(function () {
            readURL(this);
    });

        $("#PostType").change(function () {
            getCateByPostType();
    });


    var getCateByPostType = function () {
            //alert("ok: getCateByPostType");
            $.ajax({
                type: "POST",
                url: '/Question/GetCateByPostType',
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify({ id: $("#PostType").val() }),
                dataType: "json",
                success: function (recData) {
                    //firstcateid = recData[0].Value;
                    //alert("ok: " + recData[0].Value);
                    $("#SuperCateId").empty();
                    /*$("#SuperCateId").append("<option value='0'>Chọn danh mục gốc</option>");*/
                    $.each(recData, function (index, optiondata) {
                        $("#SuperCateId").append("<option value='" + optiondata.Value + "'>" + optiondata.Text + "</option>");
                    });
                },
                error: function () { alert('Có lỗi (ajax) xảy ra!'); }
            });
    }

    //var getSubCateOnload = function (cateid) {
    //        //alert("Vô getSubCateOnload, cateid = " + cateid)
    //        $.ajax({
    //            type: "POST",
    //            url: '/Post/GetSubCate',
    //            contentType: "application/json; charset=utf-8",
    //            data: JSON.stringify({ id: cateid }),
    //            dataType: "json",
    //            success: function (recData) {
    //                $("#CateId").empty();
    //                $.each(recData, function (index, optiondata) {
    //                    $("#CateId").append("<option value='" + optiondata.Value + "'>" + optiondata.Text + "</option>");
    //                });
    //            },
    //            error: function () { alert('Có lỗi (ajax) xảy ra!'); }
    //        });
