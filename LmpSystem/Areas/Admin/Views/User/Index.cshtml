                            </nav>
                        }
                    }
                </div>
            </div>
        </div>*@

</div>

<!--Xoa the modal-->
<div class="modal fade" id="deleteModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Bạn có chắc muốn xóa User ?</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" id="deleteBtn" class="btn btn-danger">Xóa</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>


<!-- Khuc nay lam cho các trang index datatable có search/phan trang-->
<script src="~/Content/AdminLTE/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/Content/AdminLTE/plugins/datatables/dataTables.bootstrap4.min.js"></script>
@*<script src="~/Content/js/ListPost.js"></script>*@
<!-- Khuc nay lam cho các trang index datatable có search/phan trang-->

<script>
    $(function () {
        $("#lstPost").DataTable();
    });

    var delmodal = $('#deleteModal');
    var idx;

    var deleteConfirm = function (id, title) {
        idx = id;
        delmodal.find('.modal-body').text(title);
        delmodal.modal('show');
    }

    $('#deleteBtn').click(function () {
        delmodal.modal('hide');
        $.ajax({
            type: "POST",
            url: '/User/DeleteUser',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: idx }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify(recData.Message, {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 2000,
                });
                setTimeout(function () {
                    window.location.reload();
                }, 2000);
            },
            error: function () {
                var notify = $.notify('<strong>Có lỗi (ajax) xảy ra, chưa xóa được!</strong>', {
                    type: 'pastel-warning',
                    allow_dismiss: false,
                });
            }
        });
    });

    var resetPassword = function (userid) {
        alert("UserId: " + userid);
        //var xid = xthis.id;
        //var st = xthis.checked;
        $.ajax({
            type: "POST",
            url: '/User/ResetPassword',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: userid }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify(recData.Message, {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 2000,
                });
            },
            error: function () { alert('Có lỗi (ajax) xảy ra, chưa reset được!'); }
        });
    }

    var changeStatus = function (xthis) {
        alert("Status: " + xthis.checked);
        var xid = xthis.id;
        var st = xthis.checked;
        $.ajax({
            type: "POST",
            url: '/User/ChangeStatus',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: xid, state: st }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify('<strong>' + recData.Message + '</strong>', {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 2000,
                });
            },
            error: function () { alert('Có lỗi (ajax) xảy ra!'); }
        });
    }

    //var changeStatusTeacher = function (xthis) {
    //    alert("Status: " + xthis.checked);
    //    var xid = xthis.id;
    //    var st = xthis.checked;
    //    $.ajax({
    //        type: "POST",
    //        url: '/User/ChangeStatusTeacher',
    //        contentType: "application/json; charset=utf-8",
    //        data: JSON.stringify({ id: xid, state: st }),
    //        dataType: "json",
    //        success: function (recData) {
    //            var notify = $.notify('<strong>Thành công</strong><br/>' + recData.Message + '<br />', {
    //                type: 'pastel-info',
    //                allow_dismiss: false,
    //                timer: 1000,
    //            });
    //        },
    //        error: function () { alert('An error occured'); }
    //    });
    //}

</script>
