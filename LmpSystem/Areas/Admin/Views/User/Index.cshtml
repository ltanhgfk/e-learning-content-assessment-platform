                                        <input style="margin-left:0px" class="btn btn-info" type="submit" value="Tìm kiếm" />
                                    </label>}
                            </div>*@

                        <div class="col-lg-1 col-sm-12 col-md-1">
                            <div class="card-tools">
                                <div class="input-group input-group-sm" style="margin-top: 10px; text-align: right">
                                    @Html.ActionLink("+Thêm người dùng", "Create", null, new { @class = "btn btn-warning" })
                                    @*<button id="addTag" class="btn btn-primary"><i class="fa fa-plus"></i> Thêm bài viết</button>*@

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- /.card-header -->
                <div class="card-body">
                    <table id="lstPost" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().Avatar)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().Username)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().FirstName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().LastName)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().Status)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Single().UserRole)
                                </th>
                                @*<th>
                                        @Html.DisplayNameFor(model => model.Single().IsTeacher)
                                    </th>*@
                                <th>
                                    Action
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <img src="~/Upload/images/@item.Avatar" style="width:100px; height:100px" />@*@Html.DisplayFor(modelItem => item.Avatar)*@
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Username)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.FirstName)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.LastName)
                                    </td>
                                    <td>
                                        @*@Html.DisplayFor(modelItem => item.Status)*@
                                        <label class="switch">
                                            <input onchange="changeStatus(this)" type="checkbox" id="@item.Id" @(item.Status == true ? "checked" : "") class="success">
                                            <span class="slider"></span>
                                        </label>
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.UserRole)

                                    </td>

                                    <td>
                                        @*@{ if (User.Identity.Name == item.Username || User.IsInRole("admin"))
                                            {*@
                                        @Html.ActionLink("Sửa", "Edit", new { id = item.Id }, new { @class = "badge badge-warning" })
                                        @Html.ActionLink("Chi tiết", "Details", new { id = item.Id }, new { @class = "badge badge-success" })
                                        <a onclick="deleteConfirm(@item.Id, '@item.Username')" href="#" class="badge badge-danger">Xóa</a>
                                        @Html.ActionLink("Sao chép", "Clone", new { id = item.Id }, new { @class = "badge badge-primary" })
                                        <a onclick="resetPassword(@item.Id)" href="#" value="@item.Id" class="badge badge-danger">Đặt lại mật khẩu mặc định (123456)</a>

                                        @*}
                                            khi bị lỗi ajax reset password, nếu truyền vào hàm là this.value thì có thể bị lỗi, nên truyền trực tiếp @item.Id
                                            }*@

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

