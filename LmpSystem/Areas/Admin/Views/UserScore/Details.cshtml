@model IEnumerable<LmpSystem.ViewModels.QuestionViewModel>

@using LmpSystem.Repository
@using LmpSystem.Models
@using LmpSystem.Common
@{
    //Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.Title = "Chi tiết bài làm trắc nghiệm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";

    UnitOfWork db = new UnitOfWork(new LmpSystemEntities());
    GetData data = new GetData();
    var web_name = data.GetLmpInfoByCode("web_name");
    if (web_name != null)
    {
        ViewBag.Title = "Kết quả bài kiểm tra trắc nghiệm môn " + ViewBag.MonHoc + " trên " + web_name.Name;  //Request.Params["subcateId"] => hok được
    }
    else
    {
        ViewBag.Title = "Kết quả bài kiểm tra trắc nghiệm môn " + ViewBag.MonHoc;
    }

    //var avgRating = Model.Reviews.Average(m => m.Rating);
    //var course_banner = data.GetLmpInfoByCode("home_banner");

    var google_seo_keyword = data.GetLmpInfoByCode("google_seo_keyword");
    if (google_seo_keyword != null)
    {
        ViewBag.Keywords = google_seo_keyword.Link + ", " + ViewBag.MonHoc;
    }

}
<script src='https://kit.fontawesome.com/a076d05399.js' crossorigin='anonymous'></script>

