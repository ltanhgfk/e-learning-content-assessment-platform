@if (Model.Count() >= 1)
{
    <!--================Start Course Details Area =================-->
    <div class="related_post" style="margin-left: 2px;">
        <h2><span>KẾT QUẢ BÀI KIỂM TRA TRẮC NGHIỆM</span></h2>
        <p>Họ tên: @ViewBag.HoVaTen, email: @ViewBag.Email</p>
        <p>Môn học: @ViewBag.MonHoc, Ngày giờ: @ViewBag.NgayGioLamKT</p>
        <p>Số câu đúng: @ViewBag.SoCauDung / Tổng số câu: @ViewBag.TongSoCau</p>
        <hr />
        @if (Model != null)
        {
            //int i = 1;
            var t = 0;
            foreach (var item in Model)
            {
                t++;
                <div class="row" style="margin-top: 20px; font-weight: bold">
                    <div class="col-lg-1 col-md-1 col-sm-1"><i style='font-size:15px' class='fas'>&#xf0ae;</i> @t.</div>
                    <div class="col-lg-10 col-md-10 col-sm-10">
                        @Html.Raw(@item.QuestionContent)
                    </div>
                </div>
                <div class="row" style="margin-top: 5px;">
                    <div class="col-lg-1 col-md-1 col-sm-1">
                        a
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        @Html.Raw(@item.Option1)
                    </div>
                    @*</div>
                        <div class="row">*@
                    <div class="col-lg-1 col-md-1 col-sm-1">
                        b
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        @Html.Raw(@item.Option2)
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-1 col-md-1 col-sm-1">
                        c
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        @Html.Raw(@item.Option2)
                    </div>
                    @*</div>
                        <div class="row">*@
                    <div class="col-lg-1 col-md-1 col-sm-1">
                        d
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        @Html.Raw(@item.Option2)
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-3" style="font-weight:bold">
                        <span>Phương án bạn chọn: </span>
                    </div>
                    <div class="col-lg-9 col-md-9 col-sm-9">
                        @Html.Raw(@item.YourAnswer)
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-3" style="font-weight:bold">
                        <span>Phương án đúng:  </span>
                    </div>
                    <div class="col-lg-9 col-md-9 col-sm-9">
                        @Html.Raw(@item.Answer)
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-3 col-md-3 col-sm-3" style="font-weight:bold">
                        <span>Diễn giải đáp án:</span>
                    </div>
                    <div class="col-lg-9 col-md-9 col-sm-9">
                        @Html.Raw(item.AnswerExplain)
                    </div>
                </div>
                <hr />
            }
        }

        @*<div class="row" style="margin-left: 2px;">
                <hr />
                <input type="submit" id="btnSaveCart" value="" />
            </div>*@

    </div>
    <!--================ End Course Details Area =================-->
}

