@model List<LmpSystem.Models.UserScore>
@using LmpSystem.Repository
@using LmpSystem.Models
@{
    ViewBag.Title = "Quản trị điểm trắc nghiệm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout_DVCP.cshtml";
    LmpSystem.Common.GetData data = new LmpSystem.Common.GetData();
    UnitOfWork db = new UnitOfWork(new LmpSystemEntities());
}

<link href="~/Content/AdminLTE/plugins/datatables/dataTables.bootstrap4.css" rel="stylesheet" />

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<div style="margin-top:10px;">

    <div class="row">
        <div class="col-12">
            <h2 class="text-center text-uppercase">Kết quả kiểm tra trắc nghiệm</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    @*<div class="row">
                        <div class="col-lg-1 col-sm-12 col-md-1">
                            <div class="card-tools">
                                <div class="input-group input-group-sm" style="margin-top: 10px; text-align: right">
                                    @Html.ActionLink("+Thêm người dùng", "Create", null, new { @class = "btn btn-warning" })
                                </div>
                            </div>
                        </div>
                    </div>*@
                </div>

                <!-- /.card-header -->
                <div class="card-body">
                    <table id="lstPost" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>
                                    @Html.DisplayName("Tên người dùng")
                                </th>
                                <th>
                                    @Html.DisplayName("Email")
                                </th>
                                <th>
                                    @Html.DisplayName("Môn học")
                                </th>
                                <th>
                                    @Html.DisplayName("Bài học")
                                </th>
                                <th>
                                    @Html.DisplayName("Tổng số câu hỏi")
                                </th>
                                <th>
                                    @Html.DisplayName("Số cấu trả lời đúng")
                                </th>
                                <th>
                                    @Html.DisplayName("Ngày thực hiện")
                                </th>
                                <th>
                                    Quản trị
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.UserName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Email)
                                </td>
                                @if ((int)item.PostId >= 0)
                                {
                                    <td>
                                        @db.PostRepository.FindByID((int)item.PostId).Name
                                    </td>
                                }
                                else
                                {
                                    <td>all</td>
                                }
                                    @if (item.LessonId >= 0)
                                    {
                                        <td>
                                            @db.LessonRepository.FindByID((int)item.LessonId).Name
                                        </td>
                                    }
                                    else
                                    {
                                        <td>all</td>
                                    }
                                    <td>
                                        @Html.DisplayFor(modelItem => item.TotalNumberQuestion)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.TrueNumberAnswer)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.CreatedOnDate)
                                    </td>

                                    <td>
                                        @Html.ActionLink("Sửa", "Edit", new { id = item.Id }, new { @class = "badge badge-warning" })
                                        @Html.ActionLink("Chi tiết", "Details", new { id = item.Id }, new { @class = "badge badge-success" })
                                        <a onclick="deleteConfirm(@item.Id, '@item.Id')" href="#" class="badge badge-danger">Xóa</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!--Xoa the modal-->
<div class="modal fade" id="deleteModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Bạn có chắc muốn xóa Feedback ?</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" id="deleteBtn" class="btn btn-danger">Xóa</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>


<!-- Khuc nay lam cho các trang index datatable có search/phan trang-->
<script src="~/Content/AdminLTE/plugins/datatables/jquery.dataTables.min.js"></script>
<script src="~/Content/AdminLTE/plugins/datatables/dataTables.bootstrap4.min.js"></script>
@*<script src="~/Content/js/ListPost.js"></script>*@
<!-- Khuc nay lam cho các trang index datatable có search/phan trang-->

<script>
    $(function () {
        $("#lstPost").DataTable();
    });

    var delmodal = $('#deleteModal');
    var idx;

    var deleteConfirm = function (id, title) {
        idx = id;
        delmodal.find('.modal-body').text(title);
        delmodal.modal('show');
    }

    $('#deleteBtn').click(function () {
        delmodal.modal('hide');
        $.ajax({
            type: "POST",
            url: '/Feedback/DeleteFeedback',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: idx }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify(recData.Message, {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 2000,
                });
                setTimeout(function () {
                    window.location.reload();
                }, 2000);
            },
            error: function () {
                var notify = $.notify('<strong>Có lỗi (ajax) xảy ra, chưa xóa được!</strong>', {
                    type: 'pastel-warning',
                    allow_dismiss: false,
                });
            }
        });
    });    

    var changeStatus = function (xthis) {
        alert("Status: " + xthis.checked);
        var xid = xthis.id;
        var st = xthis.checked;
        $.ajax({
            type: "POST",
            url: '/Feedback/ChangeStatus',
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({ id: xid, state: st }),
            dataType: "json",
            success: function (recData) {
                var notify = $.notify('<strong>' + recData.Message + '</strong>', {
                    type: 'pastel-info',
                    allow_dismiss: false,
                    timer: 2000,
                });
            },
            error: function () { alert('Có lỗi (ajax) xảy ra!'); }
        });
    }
</script>
