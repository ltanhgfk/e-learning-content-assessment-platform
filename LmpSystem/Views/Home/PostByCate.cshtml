<div class="single_post_content">
    <ul>
        @*//data.GetSubCategories(cateId)) //Convert.ToInt32(Request.QueryString["id"])*@
        @foreach (var item in Model)
        {
            <li class="cat-item">
                <a id="@item.Id" href="@Url.Action("PostBySubCate", "Home", new { subcateid = @item.Id, subcatename = data.GenerateFriendlyName(item.Name.Trim()) })" title="@item.Name">
                    @item.Name
                </a>
            </li>
            keyword = keyword + @item.Name + ", ";
        }
        @{
            //ViewBag.Keywords = "ok con de, tu khoa, lap trinh, trai tim";
            var google_seo_keyword = data.GetLmpInfoByCode("google_seo_keyword");
            if (google_seo_keyword != null)
            {
                ViewBag.Keywords = google_seo_keyword.Link + ", " + keyword;
            }
            else
            {
                ViewBag.Keywords = keyword;
            }
        }
    </ul>
</div>

@*data.GetSubCategories(cateId)) //Convert.ToInt32(Request.QueryString["id"])*@
@foreach (var itemsub in Model)
{
    var postbysubcate = db.PostRepository.GetAll().Where(m => m.CateId == itemsub.Id && m.Status == true && (m.PostType == "special" || m.PostType == "article")).OrderByDescending(m => m.LastModifiedOnDate).Take(9).ToList();  @*Where(m => m.PostType != "other" && m.PostType != "course" && m.PostType != "news" && m.PostType != "inform").*@
    if (postbysubcate.Count >= 1)
    {
        <div class="callout top-left"> <a href='@Url.Action("PostBySubCate", "Home", new { subcateid = itemsub.Id, subcatename = data.GenerateFriendlyName(itemsub.Name.Trim()) })'> <i class="fa fa-tags"></i> @itemsub.Name </a></div>
        <div class="single_post_content_other_cate">

            @*<div class="single_post_content_left">
                    <ul class="business_catgnav  wow fadeInDown">
                        <li>
                            <figure class="bsbig_fig">
                                <a href='@Url.Action("PostDetail", "Home", new { postid = @postbysubcate[0].Id, postname = data.GenerateFriendlyName(@postbysubcate[0].Name.Trim()) })' class="featured_img" title="@postbysubcate[0].Name"> <img alt="@postbysubcate[0].Name" src="~/Upload/images/@postbysubcate[0].Avatar"> <span class="overlay"></span> </a>
                                <figcaption> <a href='@Url.Action("PostDetail", "Home", new { postid = @postbysubcate[0].Id, postname = data.GenerateFriendlyName(@postbysubcate[0].Name.Trim())})' title="@postbysubcate[0].Name">@postbysubcate[0].Name</a> </figcaption>
                                <p class="big_sub_post_info" ><i class="fa fa-calendar"></i> @String.Format("{0:dd/MM/yyyy}", @postbysubcate[0].LastModifiedOnDate)   <i class="fa fa-user"></i> @data.GetFullnameByUserId((int)@postbysubcate[0].UserId) <a href='@Url.Action("PostBySubCate", "Home", new { subcateid = @postbysubcate[0].CateId, subcatename = data.GenerateFriendlyName(@postbysubcate[0].Name.Trim())})'> <i class="fa fa-tags"></i> @db.CategoryRepository.FindByID(@postbysubcate[0].CateId).Name</a></p>
                                @Html.Raw(@postbysubcate[0].Resume)
                            </figure>
                        </li>
                    </ul>
                </div>*@

            <div class="row">
                <div class="spost_nav">
                    @for (int i = 0; i < postbysubcate.Count; i++)
                    {
                        <div class="col-lg-12 col-md-12 col-sm-12" style="margin-top:5px;">
                            <div class="media wow fadeInDown">
                                <a href='@Url.Action("PostDetail", "Home", new { postid = @postbysubcate[i].Id, postname = data.GenerateFriendlyName(@postbysubcate[i].Name.Trim()) })' class="media-left" title="@postbysubcate[i].Name"> <img alt="@postbysubcate[i].Name" src="~/Upload/images/@postbysubcate[i].Avatar"> </a>
                                <div class="media-body">
                                    <a href='@Url.Action("PostDetail", "Home", new { postid = @postbysubcate[i].Id, postname = data.GenerateFriendlyName(@postbysubcate[0].Name.Trim()) })' class="catg_title" @postbysubcate[i].Name>@postbysubcate[i].Name</a>
                                    <p class="small_sub_post_info">@*<i class="fa fa-calendar"></i> @String.Format("{0:dd/MM/yyyy}", @postbysubcate[i].LastModifiedOnDate)*@ <i class="fa fa-user"></i> @data.GetFullnameByUserId((int)@postbysubcate[i].UserId) &nbsp;</p>
                                    @*<p>@postbysubcate[i].Resume</p>*@
                                </div>
                            </div>
                            <hr />
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    @*else
    {
        <p class="catg_title"> &raquo; Chưa có bài viết nào trong mục này! </p>
    }*@
}
