<div class="single_post_content">
    <ul>
        @*//data.GetSubCategories(cateId)) //Convert.ToInt32(Request.QueryString["id"])*@
        @foreach (var item in Model)
        {
            <li class="cat-item">
                <a id="@item.Id" href="@Url.Action("PostBySubCate", "Home", new { subcateid = @item.Id, subcatename = data.GenerateFriendlyName(item.Name.Trim()) })" title="@item.Name">
                    @item.Name
                </a>
            </li>
            keyword = keyword + @item.Name + ", ";           
        }
        @{
            //ViewBag.Keywords = "ok con de, tu khoa, lap trinh, trai tim";
            var google_seo_keyword = data.GetLmpInfoByCode("google_seo_keyword");
            if (google_seo_keyword != null)
            {
                ViewBag.Keywords = google_seo_keyword.Link + ", " + keyword;
            }
            else
            {
                ViewBag.Keywords = keyword;
            }
        }
    </ul>
</div>

@*data.GetSubCategories(cateId)) //Convert.ToInt32(Request.QueryString["id"])*@
