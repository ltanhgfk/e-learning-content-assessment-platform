                                            <p class="small_sub_post_info" ><i class="fa fa-calendar"></i> @String.Format("{0:dd/MM/yyyy}", @postbyothersubcateid[i].LastModifiedOnDate) <i class="fa fa-user"></i> @data.GetFullnameByUserId((int)@postbyothersubcateid[i].UserId) <a href='@Url.Action("PostBySubCate", "Home", new { subcateid = @postbyothersubcateid[i].CateId, subcatename = data.GenerateFriendlyName(@postbyothersubcateid[i].Name.Trim())})'> <i class="fa fa-tags"></i> @db.CategoryRepository.FindByID(@postbyothersubcateid[i].CateId).Name</a></p>
