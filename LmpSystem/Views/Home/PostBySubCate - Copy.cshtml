                                    <p class="big_sub_post_info"><i class="fa fa-calendar"></i> @String.Format("{0:dd/MM/yyyy}", @postbyothersubcateid[0].LastModifiedOnDate) <i class="fa fa-user"></i> @data.GetFullnameByUserId((int)@postbyothersubcateid[0].UserId) <a href='@Url.Action("PostBySubCate", "Home", new { subcateid = @postbyothersubcateid[0].CateId, subcatename = data.GenerateFriendlyName(@postbyothersubcateid[0].Name.Trim())})'> <i class="fa fa-tags"></i> @db.CategoryRepository.FindByID(@postbyothersubcateid[0].CateId).Name</a></p>
