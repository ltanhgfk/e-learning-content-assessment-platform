@using System.Net
@using LmpSystem.Common
@using LmpSystem.Repository
@using LmpSystem.Models
@using System.Globalization
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    UnitOfWork db = new UnitOfWork(new LmpSystemEntities());
    CultureInfo cul = CultureInfo.GetCultureInfo("vi-VN");   //try with "en-US"
    GetData data = new GetData();

    //int subcateId = Convert.ToInt32(Request.QueryString["subcateid"]);//Request.Params["subcateId"] => hok được
    int subcateId = Convert.ToInt32(ViewBag.subCateId);

    var web_name = data.GetLmpInfoByCode("web_name");
    if (web_name != null)
    {
        ViewBag.Title = "Danh sách bài viết theo danh mục " + web_name.Name;  //Request.Params["subcateId"] => hok được
    }
    else
    {
        ViewBag.Title = "Danh sách bài viết theo danh mục";
    }

    var keyword = "";
}
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<style>
    .active_subcate {
        background-color: #FFCC00 !important;
        color: #000;
    }
</style>

<script>
    $(document).ready(function () {
        $("#@subcateId").removeClass("df");
        $("#@subcateId").addClass("active_subcate");
    });
</script>

@if (subcateId >= 1)
{
    var postbysubcateid = db.PostRepository.GetAll().Where(m => m.CateId == subcateId && m.Status == true).ToList();

    <div class="single_post_content">
        <ul>
            @foreach (var item in data.GetOtherSubCategories(subcateId)) //Convert.ToInt32(Request.QueryString["id"])
            {
                <li class="cat-item">
                    <a id="@item.Id" class="none" href="@Url.Action("PostBySubCate", "Home", new { subcateid = @item.Id, subcatename = data.GenerateFriendlyName(item.Name.Trim()) })">
                        @item.Name
                    </a>
                </li>
                keyword = keyword + @item.Name + ", ";
            }

            @{
                //ViewBag.Keywords = "ok con de, tu khoa, lap trinh, trai tim";
                var google_seo_keyword = data.GetLmpInfoByCode("google_seo_keyword");
                if (google_seo_keyword != null)
                {
                    ViewBag.Keywords = google_seo_keyword.Link + ", " + keyword;
                }
                else
                {
                    ViewBag.Keywords = keyword;
                }
            }
        </ul>
    </div>

    <div class="callout top-left">@db.CategoryRepository.FindByID(subcateId).Name</div>
    <div class="single_post_content_other_cate">        
        <div class="row">
            @foreach (var item in postbysubcateid)
            {
                <div class="col-lg-6 col-md-6 col-sm-6" style="margin-top:5px;">
                    <a href='@Url.Action("PostDetail", "Home", new { postid = item.Id , postname = data.GenerateFriendlyName(item.Name.Trim())})' class="media-left" title="@item.Name"> <img alt="@item.Name" src="~/Upload/images/@item.Avatar"> </a>
                    <div class="media-body">
                        <a href='@Url.Action("PostDetail", "Home", new { postid = item.Id , postname = data.GenerateFriendlyName(item.Name.Trim())})' class="catg_title" title="@item.Name"> @item.Name</a>
                        <p class="small_sub_post_info"> @*<i class="fa fa-calendar"></i> @String.Format("{0:dd/MM/yyyy}", item.LastModifiedOnDate)*@ <i class="fa fa-user"></i> @data.GetFullnameByUserId((int)item.UserId) <a href='@Url.Action("PostBySubCate", "Home", new { subcateid = item.CateId, subcatename = data.GenerateFriendlyName(item.Name.Trim())})'> <i class="fa fa-tags"></i> @db.CategoryRepository.FindByID(item.CateId).Name</a></p>
                    </div>
                    <hr />
                </div>
            }
        </div>
    </div>

    @*foreach (var itemsub in data.GetOtherSubCategories(subcateId).Where(m => m.Id != subcateId)) //Convert.ToInt32(Request.QueryString["id"])
