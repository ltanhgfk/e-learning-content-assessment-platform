        <div class="single_post_content">
            <div class="row">
                @{
                    var prevousPost = db.PostRepository.GetAll().Where(m => m.Status == true && m.Position < Model.Position && (m.PostType == "special" || m.PostType == "article")).OrderByDescending(m => m.Position).Take(1).FirstOrDefault();
                    var nextPost = db.PostRepository.GetAll().Where(m => m.Status == true && m.Position > Model.Position && (m.PostType == "special" || m.PostType == "article")).OrderBy(m => m.Position).Take(1).FirstOrDefault();
                }                
                    <div class="col-lg-6 col-md-6 col-sm-6" style="margin-top:20px;">
                        <div class="media wow fadeInDown">
                            <p class="small_sub_post_info">
                                &laquo; Bài trước
                            </p>
                            @if (prevousPost != null)
                            {
                                <div style="width: 100%">
                                    <a href='@Url.Action("PostDetail", "Home", new { postid = prevousPost.Id, postname = data.GenerateFriendlyName(prevousPost.Name.Trim()) })' class="catg_title" title="@prevousPost.Name"> @prevousPost.Name</a>
                                </div>
                            }
                            </div>
                    </div>               
                
                    <div class="col-lg-6 col-md-6 col-sm-6" style="margin-top:20px;text-align: right">
                        <div class="media wow fadeInDown">
                            <p class="small_sub_post_info">
                                Bài kế tiếp &raquo;
                            </p>
                            @if (nextPost != null)
                            {
                                <div style="width: 100%">
                                    <a href='@Url.Action("PostDetail", "Home", new { postid = nextPost.Id, postname = data.GenerateFriendlyName(nextPost.Name.Trim()) })' class="catg_title" title="@nextPost.Name"> @nextPost.Name</a>
                                </div>
                            }
                            </div>
                    </div>                
            </div>
        </div>

        <div class="related_post">
            @*if (facebook_commnent_code != null)*@
            @{
                @*@Html.Raw(@facebook_commnent_code.Content)*@
                //var url = "http://hoccungcophuong.edu.vn/chi-tiet-bai-viet-" + data.GenerateFriendlyName(Model.Name.Trim()) + "-" + @Model.Id + "-html";
                <div class="fb-comments" data-href=@url data-width="100%" data-numposts="5"></div>
            }
        </div>

        @{
            var otherpost = db.PostRepository.GetAll().Where(m => m.CateId == Model.CateId && m.Status == true && m.Id != Model.Id && (m.PostType == "special" || m.PostType == "article")).OrderByDescending(m => m.LastModifiedOnDate).ToList();
            if (otherpost.Count >= 1)
            {
                <div class="related_post">
                    @*<h2>Bài viết khác cùng danh mục</h2>*@
                    <div class="callout top-left">Các bài viết khác cùng thể loại</div>
                    <div class="single_post_content_other_cate">
                        <div class="row">
                            @foreach (var item in otherpost)
                            {
                                <div class="col-lg-6 col-md-6 col-sm-6" style="margin-top:20px;">
                                    <div class="media wow fadeInDown">
                                        <a href='@Url.Action("PostDetail", "Home", new { postid = item.Id, postname = data.GenerateFriendlyName(item.Name.Trim()) })' class="media-left" title="@item.Name"> <img alt="@item.Name" src="~/Upload/images/@item.Avatar"> </a>
                                        <div class="media-body">
                                            <a href='@Url.Action("PostDetail", "Home", new { postid = item.Id, postname = data.GenerateFriendlyName(item.Name.Trim()) })' class="catg_title" title="@item.Name"> @item.Name</a>
                                            <p class="small_sub_post_info">@*<i class="fa fa-calendar"></i> @String.Format("{0:dd/MM/yyyy}", item.LastModifiedOnDate)*@   <i class="fa fa-user"></i> @data.GetFullnameByUserId((int)item.UserId) &nbsp;<a href='@Url.Action("PostBySubCate", "Home", new { subcateid = item.CateId, subcatename = data.GenerateFriendlyName(item.Name.Trim())})'> <i class="fa fa-tags"></i> @db.CategoryRepository.FindByID(item.CateId).Name</a></p>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @*/*slide trái phải <>*/*@
    <nav class="nav-slit">
        @if (slide_left != null)
        {
            <a class="prev" href="@slide_left.Link">
                <span class="icon-wrap"><i class="fa fa-angle-left"></i></span>
                <div>

                    <h3>@slide_left.Name</h3>
                    <img src="~/Upload/images/@slide_left.Avatar" alt="@slide_left.Name" />
                    }
                </div>
            </a>
        }
        @if (slide_right != null)
        {
            <a class="next" href="@slide_right.Link">
                <span class="icon-wrap"><i class="fa fa-angle-right"></i></span>
                <div>
                    <h3>@slide_right.Name</h3>
                    <img src="~/Upload/images/@slide_right.Avatar" alt="@slide_right.Name" />
                </div>
            </a>
        }
    </nav>

