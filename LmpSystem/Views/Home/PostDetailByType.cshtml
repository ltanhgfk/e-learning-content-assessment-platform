    <h1>@Model.Name</h1>

    <div class="related_post" style="color:#666; margin-top: 10px; font-size: 13px;">
        <p>@Model.Resume</p>
    </div>

    <div class="post_commentbox related_post">
        <a href="#">
            <i class="fa fa-user"></i>@data.GetFullnameByUserId(Model.UserId)
        </a>
        <span><i class="fa fa-calendar"></i>@String.Format("{0:dd/MM/yyyy}", Model.LastModifiedOnDate)</span>
        @*<a href='@Url.Action("PostBySubCate", "Home", new { subcateid = Model.CateId, subcatename = data.GenerateFriendlyName(Model.Name.Trim()) })' title="@Model.CateName"><i class="fa fa-tags"></i>@Model.CateName</a>*@
    </div>

    @if (@Model.Video != null)
    {
        <div class="related_post">
            @Html.Raw(Model.Video)
        </div>
    }
        <div class="related_post">
            @Html.Raw(Model.Content)
        </div>
        
        <div class="related_post" style="border: 1px solid #eee; padding: 10px 0px 0px 10px">
            @{
                var url = "http://hoccungcophuong.edu.vn/chi-tiet-bai-viet-" + data.GenerateFriendlyName(Model.Name.Trim()) + "-" + @Model.Id + "-html";
            }
            <div style="float:left; margin-right: 6px; font-weight: bold">Chia sẻ: </div>
            <div style="float: left; margin-right: 6px">
                <a href="https://twitter.com/share?ref_src=twsrc%5Etfw" class="twitter-share-button" data-show-count="true">Tweet</a>
                <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
            </div>
            <div style="float: left; margin-right: 6px">
                <div class="fb-like" data-href=@url data-width="" data-layout="button_count" data-action="like" data-size="small" data-share="true"></div>
            </div>
            <div style="float: left; margin-right: 6px">
                <g:plusone></g:plusone>
            </div>
        </div>

        @*<div class="related_post">
            <ul>
                @foreach (var item in Model.PostTags)
                {
                    <li class="cat-item"><a href='@Url.Action("PostByTagType", "Home", new { tagid = @item.TagID, post_type = Model.PostType, tagname = data.GenerateFriendlyName(item.TagName.Trim()) })' title="@item.TagName">@item.TagName</a></li>
                    keyword = keyword + @item.TagName + ", ";
