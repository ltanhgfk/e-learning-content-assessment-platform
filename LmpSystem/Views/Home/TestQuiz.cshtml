<script>
    // Create an object:
    const answer = {
        qId: 0,
        yourAns: 'Option0',
        trueAns: 'Option0'
    };

    var answer_array = new Array(answer);

    var score = 0;

    function Engine(stt, questionId, trueAnswer, yourAnswer) {
        //alert("Stt: " + stt + ", questionId: " + questionId + ", cau dung: " + trueAnswer + ", tra loi" + yourAnswer);
        if (trueAnswer == "" || trueAnswer == null) {
            //ans[question] = "Câu hỏi thiếu đáp án!"
            alert("Câu hỏi bị lỗi!");
            return false;
        }

        answer_array[stt] = { qId: questionId, trueAns: trueAnswer, yourAns: yourAnswer };
    }

</script>

