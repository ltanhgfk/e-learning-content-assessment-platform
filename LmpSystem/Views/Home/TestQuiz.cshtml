@if (Model.Count() >= 1)
{
    <!--================Start Course Details Area =================-->
<div class="related_post" style="margin-left: 2px;">
    <h2></h2>
    @using (Html.BeginForm("TestQuiz", "Home", FormMethod.Post))
    {
        @Html.Hidden("PostId")
        @Html.Hidden("LessonId")

        @*@Html.Hidden("UserName")
          @Html.Hidden("Email")*@

        @Html.Hidden("TestDetail")
        @Html.Hidden("TrueNumberAnswer")
        @Html.Hidden("TotalNumberQuestion")

        if (Model != null)
        {
            //int i = 1;
            var t = 0;
            foreach (var item in Model)
            {
                t++;
                <div class="row" style="margin-top: 20px; font-weight: bold">
                    <div class="col-lg-1 col-md-1 col-sm-1">&nbsp;@t.</div>
                    <div class="col-lg-10 col-md-10 col-sm-10">
                        @Html.Raw(@item.QuestionContent)
                    </div>
                </div>
                <div class="row" style="margin-top: 5px;">
                    <div class="col-lg-1 col-md-1 col-sm-1">
                        <input type="radio" value="Option1" name="q&@t" onclick="Engine(@t, @item.Id,'@item.Answer', this.value)" style="height:15px; width:15px;" />
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        @Html.Raw(@item.Option1)
                    </div>
                    @*</div>
                        <div class="row">*@
                    <div class="col-lg-1 col-md-1 col-sm-1">
                        <input type="radio" value="Option2" name="q&@t" onclick="Engine(@t, @item.Id,'@item.Answer', this.value)" style="height:15px; width: 15px;" />
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        @Html.Raw(@item.Option2)
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-1 col-md-1 col-sm-1">
                        <input type="radio" value="Option3" name="q&@t" onclick="Engine(@t, @item.Id,'@item.Answer', this.value)" style="height: 15px; width: 15px;" />
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        @Html.Raw(@item.Option3)
                    </div>
                    @*</div>
                        <div class="row">*@
                    <div class="col-lg-1 col-md-1 col-sm-1">
                        <input type="radio" value="Option4" name="q&@t" onclick="Engine(@t, @item.Id,'@item.Answer', this.value)" style="height: 15px; width: 15px;" />
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        @Html.Raw(@item.Option4)
                    </div>
                </div>

                <script>
                        answer_array[@t] = { qId: @item.Id, trueAns: "--", yourAns: "--" };
                </script>

                //if (cateId == -1)
                //{
                //    cateId = (int)item.CateId;
                //}
                <hr />
            }
        }
        else
        {
            <div>Chưa có câu hỏi</div>
        }

        <div class="row" style="margin-left: 2px;">
            @*<hr />*@
            @Html.TextBox("UserName", "", new { @placeholder = "Nhập họ tên", required = "required" })
            @Html.TextBox("Email", "", new { @placeholder = "Nhập Email", required = "required", type = "email" })

            <input type="submit" id="btnSaveCart" value="Xem kết quả" /> @*onclick="Score()"*@
        </div>
        @*<div class="row" style="margin-top: 10px;">
            </div>*@
    }
</div>
    <!--================ End Course Details Area =================-->
}

