                                    }
                                </ul>
                        </div>
                    </div>*@
                <div class="col-lg-4 col-md-4 col-sm-4">
                    <div class="footer_widget wow fadeInDown">
                        <h2>Danh mục</h2>
                        <ul>
                            @{
                                var parent_false = db.CategoryRepository.GetAll().Where(m => m.Status == false && m.ParentId == -1).Select(m => m.Id).ToList();

                                foreach (var item in db.CategoryRepository.GetAll().Where(m => m.Status == true && m.ParentId != -1 && (parent_false.Contains((int)m.ParentId) == false)).ToList())
                                {
                                    <li class="cat-item_footer"><a href="@Url.Action("PostBySubCate","Home", new { subcateid = @item.Id, subcatename = data.GenerateFriendlyName(item.Name.Trim())  })" title="@item.Name">@item.Name</a></li>
                                }
                            }
                        </ul>

                    </div>
                </div>
                <div class="col-lg-4 col-md-4 col-sm-4">
                    <div class="footer_widget wow fadeInRightBig">
                        <h2>DỊCH VỤ</h2>
                        <ul>
                            @foreach (var item in main_menu_list)
                            {
                                <li class="cat-item_footer">
                                    <a href="@Url.Action("CommonPage", "Home", new { id = item.Id, code = data.GenerateFriendlyName(item.Name.Trim()) })" title="@item.Name">
                                        @item.Name
                                    </a>
                                </li>
                            }
                        </ul>
                        <ul>
                            @foreach (var item in common_page_footer_list)
                            {
                                <li class="cat-item_footer">
                                    <a href="@Url.Action("CommonPage", "Home", new { id = item.Id, code = data.GenerateFriendlyName(item.Name.Trim()) })" title="@item.Name">
                                        @item.Name
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer_bottom">
            @if (copyright != null)
            {
                <p class="copyright">
                    @*<script>document.write(new Date().getFullYear());</script>*@
                    @*@Html.Raw(@copyright.Content)*@
                    @copyright.Name
