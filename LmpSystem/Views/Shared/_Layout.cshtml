            <div class="row">
                <div class="col-lg-4 col-md-4 col-sm-4">
                    <div class="footer_widget wow fadeInLeftBig">
                        <h2>
                            @if (web_name != null)
                            {
                                @web_name.Name
                            }
                        </h2>

                        @if (footer_logo != null)
                        {
                            <img src="~/Upload/images/@footer_logo.Avatar" alt="@web_name.Name" width="80%">
                        }

                        <div class="social_link_footer">
                            <ul class="social_nav_footer">
                                @foreach (var item in social_network_list)
                                {
                                    <li class="@item.Name"><a href="@item.Link"></a></li>
                                }
                            </ul>
                        </div>

                        @if (@contact_info != null)
                        {
                            <div>
                                @Html.Raw(@contact_info.Content)
                            </div>
                        }
                        @*@foreach (var item in contact_info_list)
                            {
                                <p>@item.Name</p>
                            }*@
                        @*<div>
                            <p>
                                @if (web_slogan != null)
                                {
                                    @web_slogan.Name
                                }
                            </p>
                            </div>*@
                    </div>
                </div>
                @*<div class="col-lg-3 col-md-3 col-sm-3">
                        <div class="footer_widget wow fadeInDown">
                            <h2>Thẻ bài viết (Tag)</h2>

                                <ul>
                                    @foreach (var item in tags)
