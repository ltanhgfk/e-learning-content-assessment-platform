                                 <button type="submit"><i class="fa fa-search"></i></button>
                            </div>*@
                        <div class="header_top_right">
                            <p>
                                <script>document.write(today.toUTCString());</script>
                            </p>
                        </div>
                    </div>
                
                <div class="col-lg-12 col-md-12 col-sm-12">
                    <div class="header_bottom">
                        <div class="logo_area">
                            @if (@web_logo != null)
                            {
                                <a href="@web_logo.Link" class="logo" title="@web_name.Link">
                                    <img src="~/Upload/images/@web_logo.Avatar" alt="@web_logo.Name" />
                                </a>
                            }
                        </div>
                        <div class="add_banner">
                            @if (top_ad_banner != null)
                            {
                                <a href="@top_ad_banner.Link" title="@top_ad_banner.Link">
                                    <img src="~/Upload/images/@top_ad_banner.Avatar" alt="@top_ad_banner.Name">
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        
    </div>

