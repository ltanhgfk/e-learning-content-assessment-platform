@using LmpSystem.Common
@using LmpSystem.Repository
@using LmpSystem.Models
@using System.Globalization
@{
    UnitOfWork db = new UnitOfWork(new LmpSystemEntities());
    GetData data = new GetData();
    CultureInfo cul = CultureInfo.GetCultureInfo("vi-VN");

    /*Thong tin chung by Code*/
    var web_name = data.GetLmpInfoByCode("web_name");
    //ViewBag.Title = web_name.Name;
    var google_seo_description = data.GetLmpInfoByCode("google_seo_description");
    //var google_seo_keyword = data.GetLmpInfoByCode("google_seo_keyword");
    //ViewBag.Keywords = data.GetLmpInfoByCode("google_seo_keyword");
    var web_logo = data.GetLmpInfoByCode("web_logo");
    var footer_logo = data.GetLmpInfoByCode("footer_logo");
    var web_slogan = data.GetLmpInfoByCode("web_slogan");
    var top_menu_list = data.GetListLmpInfoByCode("top_menu_list");//menu đầu trang
    var top_ad_banner = data.GetLmpInfoByCode("top_ad_banner");//[Display(Name = "Banner QC đầu trang")]
    var main_menu_list = data.GetListLmpInfoByCode("main_menu_list");//[Display(Name = "Danh mục chính")]
    var social_network_list = data.GetListLmpInfoByCode("social_network_list");// [Display(Name = "Mạng xã hội")]
    var top_right_youtube_video = data.GetLmpInfoByCode("top_right_youtube_video");//[Display(Name = "Video giới thiệu (youtube)")]
    var first_right_ad_banner = data.GetLmpInfoByCode("first_right_ad_banner");// [Display(Name = "Banner quảng cáo số 1 bên phải")]
    var second_right_ad_banner = data.GetLmpInfoByCode("second_right_ad_banner");//[Display(Name = "Banner quảng cáo số 2 bên phải")]
    var fanpage_facebook = data.GetLmpInfoByCode("fanpage_facebook");//[Display(Name = "Facebook Fanpage")]
                                                                     //var googlemap = data.GetLmpInfoByCode("googlemap");//[Display(Name = "Google map")]
    var copyright = data.GetLmpInfoByCode("copyright");//[Display(Name = "Dòng bản quyền (copyright)")]
    var developed = data.GetLmpInfoByCode("developed");//[Display(Name = "Người phát triển (developer)")]
    var contact_intro = data.GetLmpInfoByCode("contact_intro");//[Display(Name = "Giới thiệu trang liên hệ")]
    var web_intro = data.GetLmpInfoByCode("web_intro");//[Display(Name = "Giới thiệu website")]
    var contact_info_list = data.GetListLmpInfoByCode("contact_info_list");//[Display(Name = "Thông tin liên hệ (address, mail, phone)")]
    var contact_info = data.GetLmpInfoByCode("contact_info_list");
    var website_link_list = data.GetListLmpInfoByCode("website_link_list");//[Display(Name = "Liên kết website")]
    var common_page_footer_list = data.GetListLmpInfoByCode("common_page_footer_list"); //[Display(Name = "Các trang tĩnh (link ở footer)")]
    var teacher_list = data.GetListLmpInfoByCode("teacher_list");

    /*****************************************/

    /*Thong tin chinh cua web*/
    var root_categories = data.GetRootCategories();
    var news = data.GetPostByType("news").Take(9).ToList();//9 tin tuc moi nhat
    var tags = data.GetTagList();
    //var latestpost = db.PostRepository.GetAll().OrderByDescending(m=>m.LastModifiedOnDate).Take(6).ToList();//6 bai viet moi nhat > main slider
    //var course = data.GetPostByType("course").Take(16).ToList();
    //var other = data.GetPostByType("rightside").Take(16).ToList();
    var inform = data.GetPostByType("inform").Take(9).ToList();
    var job = data.GetPostByType("job").Take(9).ToList();
    /*************************/
}


